# Copy to .env and replace values.
# Real .env must not be committed to git.

LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me

# Memory DB
MEMORY_POSTGRES_DB=slowrig_memory
MEMORY_POSTGRES_USER=slowrig_memory
MEMORY_POSTGRES_PASSWORD=change-me-memory-db-password

# Telegram bot (Stage 5.1 plan placeholders; real token only in .env)
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_DEFAULT_MODEL=slowrig/coder
TELEGRAM_ARCHITECT_MODEL=slowrig/architect
# Optional HTTP(S) proxy for Telegram Bot API when api.telegram.org is blocked.
# Use http://host:port or https://host:port. Telegram tg:// MTProto links are not supported.
# Leave empty when direct Telegram API egress works.
TELEGRAM_PROXY_URL=
